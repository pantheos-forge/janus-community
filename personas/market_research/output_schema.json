{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "A 2-4 sentence executive summary of the market/topic."
    },
    "key_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "finding": {"type": "string"},
          "sources": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        },
        "required": ["finding", "sources"],
        "additionalProperties": false
      }
    },
    "competitive_landscape": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "note": {"type": "string"},
          "sources": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        },
        "required": ["name", "note", "sources"],
        "additionalProperties": false
      }
    },
    "risks": {"type": "array", "items": {"type": "string"}},
    "opportunities": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["summary", "key_findings", "competitive_landscape", "risks", "opportunities"],
  "additionalProperties": false
}
