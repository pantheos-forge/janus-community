# LLM provider selection (see janus/core/config.py). All optional.
# First configured wins, in this precedence:
#   ds4_url > openrouter_model > local_model > use_claude_agent_sdk > ANTHROPIC_API_KEY

# Native Anthropic — a direct API key:
# ANTHROPIC_API_KEY=

# OpenRouter — needs BOTH the key and a model:
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Claude Code — run on your `claude` CLI login (OAuth/subscription), no API key.
#   Requires the `claude` CLI installed + logged in. Because every var above
#   outranks it, leave ANTHROPIC_API_KEY / OPENROUTER_* / DS4_* / LOCAL_MODEL
#   unset for this to actually be selected. Interactive ask_user works here.
# USE_CLAUDE_AGENT_SDK=true
# JANUS_AUTH_MODE=manual

# Containerized-agent validation: seconds allowed for EACH in-container smoke
# build and run (default 1800). Raise for slow-tool agents (OSINT/security CLI
# sweeps) whose in-container run legitimately exceeds the default.
# JANUS_CONTAINER_SMOKE_TIMEOUT=1800
